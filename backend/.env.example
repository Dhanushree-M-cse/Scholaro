# SCHOLARO Backend Environment Variables
# Copy this file to .env and fill in your values for local development.
# For Vercel deployment, add these variables in the Vercel Project Dashboard (Settings > Environment Variables).
# NEVER commit your actual .env file or real credentials to GitHub.

# Server
NODE_ENV=production
PORT=5000

# Cloud MySQL Database Configuration (Required for Vercel deployment)
DB_HOST=your_cloud_mysql_host
DB_PORT=3306
DB_USER=your_cloud_mysql_user
DB_PASSWORD=your_cloud_mysql_password
DB_NAME=scholaro_db

# SSL Configuration for Cloud MySQL (e.g. TiDB Cloud, Aiven, Railway)
DB_SSL=true

# JWT Authentication Secret — use a strong 32+ character random string
JWT_SECRET=your_long_random_jwt_secret_key_minimum_32_chars

