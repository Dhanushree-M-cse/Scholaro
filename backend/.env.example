# SCHOLARO Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to GitHub.

# Server
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# For local development: use localhost
# For Render deployment: set these to your Cloud MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=scholaro_db

# Set DB_SSL=true if your Cloud MySQL provider requires SSL (e.g. PlanetScale, Aiven, Railway)
DB_SSL=false

# JWT Authentication Secret — must be a long random string
JWT_SECRET=your_jwt_secret_key_change_this_to_a_long_random_string

# Frontend URL for CORS
# For local development: http://localhost:3000
# For Render deployment: set to your Vercel app URL e.g. https://scholaro.vercel.app
FRONTEND_URL=http://localhost:3000
